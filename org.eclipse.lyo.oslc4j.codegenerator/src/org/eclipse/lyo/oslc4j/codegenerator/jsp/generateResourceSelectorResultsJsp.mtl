[module generateResourceSelectorResultsJsp('http://org.eclipse.lyo/oslc4j/adaptorInterface')]

[import org::eclipse::lyo::oslc4j::codegenerator::services::services/]
[import org::eclipse::lyo::oslc4j::codegenerator::services::jspServices/]

[template public generateResourceSelectorResultsJsp(aSelectionDialog: Dialog)]
[if (containingAdaptorInterface(aSelectionDialog).generateJspFile(resourceSelectorResultsJspFullFileName(aSelectionDialog)))]
[file (resourceSelectorResultsJspFullFileName(aSelectionDialog), false, 'UTF-8')]
<%--
 Copyright (c) 2026 Contributors to the Eclipse Foundation

 See the NOTICE file(s) distributed with this work for additional
 information regarding copyright ownership.

 This program and the accompanying materials are made available under the
 terms of the Eclipse Distribution License 1.0 which is available at
 http://www.eclipse.org/org/documents/edl-v10.php.

 SPDX-License-Identifier: BSD-3-Simple

 This file is generated by Lyo Designer (https://www.eclipse.org/lyo/)
--%>

<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ page contentType="text/html" language="java" pageEncoding="UTF-8" %>

<aside>
  <nav>
    <c:choose>
      <c:when test="${not empty selectorError}">
        <p>${selectorError}</p>
      </c:when>
      <c:when test="${empty resources}">
        <p>No OSLC resources found.</p>
      </c:when>
      <c:otherwise>
        <ul>
          <c:forEach var="resource" items="${resources}">
            <li>
              <a href="${resource.about}"
                onclick="sendOslcSelectionPostMessage(this, event)">${resource}</a>
            </li>
          </c:forEach>
        </ul>
      </c:otherwise>
    </c:choose>
  </nav>
</aside>
[/file]
[/if]
[/template]
