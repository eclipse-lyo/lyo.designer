    public static final String [vocabularyPreferredNamespacePrefixConstantName(aVocabulary)/] = [javaInterfaceNameForConstants(aVocabulary)/].[vocabularyPreferredNamespacePrefixConstantName(aVocabulary)/];

    private [javaVocabularyClassName(aVocabulary) /]() {}

    private static QName get(String local) {
        return CACHE.computeIfAbsent(local, l -> new QName([vocabularyNamespaceConstantName(aVocabulary)/], l));
