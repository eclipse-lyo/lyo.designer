    public static QName of(String local) { return get(local); }

    [for (aClass: Class | aVocabulary.classes->sortedBy(name))]
    public static final String [classConstantName(aClass)/] = [javaInterfaceNameForConstants(aVocabulary)/].[classConstantName(aClass)/];
    public static final String [classTypeConstantName(aClass)/] = [javaInterfaceNameForConstants(aVocabulary)/].[classTypeConstantName(aClass)/];
    [/for]

    [for (aProperty: Property | aVocabulary.properties->sortedBy(name))]
    public static final String [propertyConstantName(aProperty)/] = [vocabularyNamespaceConstantName(aVocabulary)/] + "[aProperty.name/]";
